{
	"name": "Ansible Terraform",
	"dockerFile": "Dockerfile",
	"updateRemoteUserUID": true,
	"runArgs": [
		"--security-opt",
		"seccomp=unconfined",
		"--security-opt",
		"label=disable",
		"--cap-add=SYS_ADMIN",
		"--cap-add=SYS_RESOURCE",
		"--device",
		"/dev/fuse",
		"--security-opt",
		"apparmor=unconfined",
		"--hostname=ansible-dev-container",
		"--volume=/var/run/docker.sock:/var/run/docker.sock:rw"
	],
	"mounts": [
		{
			"source": "${localWorkspaceFolder}/.terraformrc",
			"target": "/root/.terraformrc",
			"type": "bind"
		}
	],
	"workspaceFolder": "/opt/${localWorkspaceFolderBasename}",
	"workspaceMount": "source=${localWorkspaceFolder},target=/opt/${localWorkspaceFolderBasename},type=bind",
	"privileged": true,
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:latest": {
			"dockerDashComposeVersion": "v2"
		}
	},
	"customizations": {
		"vscode": {
			"settings": {
				"editor.formatOnPaste": false,
				"editor.formatOnType": false,
				"editor.formatOnSave": true,
				"files.autoSave": "off",
				"terminal.integrated.defaultProfile.linux": "bash",
				"terraform.languageServer.pathToOpenTofuOrTerraform": "terraform",
				"python.defaultInterpreterPath": "/opt/venv/bin/python3",
				"python.interpreterPath": "/opt/venv/bin/python3",
				"python.terminal.activateEnvInCurrentTerminal": true,
				"ansible.ansible.path": "/opt/venv/bin/ansible",
				"ansible.python.interpreterPath": "/opt/venv/bin/python3",
				"ansible.validation.lint.path": "/opt/venv/bin/ansible-lint",
				"ansible.validation.lint.enabled": true
			},
			"extensions": [
				"ms-python.python",
				"hashicorp.terraform",
				"hashicorp.hcl",
				"4ops.terraform",
				"wholroyd.jinja",
				"redhat.ansible",
				"redhat.vscode-yaml",
				"redhat.vscode-redhat-account"
			]
		}
	},
	"postCreateCommand": {
		"community modules": "ansible-galaxy collection install community.general community.docker ansible.posix",
		"molecule": "pip install \"molecule\" \"molecule-plugins[docker]\"",
		"chown": "chown -R 100:1000 /opt/${localWorkspaceFolderBasename}"
	}
}
