{
	"name": "Ansible Terraform",
	"dockerFile": "Dockerfile",
	"containerUser": "root",
	"runArgs": [
		"--security-opt",
		"seccomp=unconfined",
		"--security-opt",
		"label=disable",
		"--cap-add=SYS_ADMIN",
		"--cap-add=SYS_RESOURCE",
		"--device",
		"/dev/fuse",
		"--security-opt",
		"apparmor=unconfined",
		"--hostname=ansible-dev-container"
	],
	"mounts": [
		{
			"source": "${localWorkspaceFolder}/.terraformrc",
			"target": "/root/.terraformrc",
			"type": "bind"
		}
	],
	"features": {
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
			"version": "latest",
			"enableNonRootDocker": true
		}
	},
	"customizations": {
		"vscode": {
			"settings": {
				"editor.formatOnPaste": false,
				"editor.formatOnType": false,
				"editor.formatOnSave": true,
				"editor.formatOnSaveMode": "file",
				"files.autoSave": "off",
				"terminal.integrated.defaultProfile.linux": "bash",
				"terraform.languageServer.pathToOpenTofuOrTerraform": "terraform",
				"python.defaultInterpreterPath": "/opt/venv/bin/python3",
				"python.interpreterPath": "/opt/venv/bin/python3",
				"ansible.ansible.path": "/opt/venv/bin/ansible",
				"ansible.python.interpreterPath": "/opt/venv/bin/python3",
				"ansible.validation.lint.path": "/opt/venv/bin/ansible-lint",
				"ansible.validation.lint.enabled": true
			},
			"extensions": [
				"ms-python.python",
				"hashicorp.terraform",
				"hashicorp.hcl",
				"4ops.terraform",
				"redhat.vscode-yaml",
				"redhat.ansible",
				"redhat.vscode-redhat-account",
				"wholroyd.jinja"
			]
		}
	},
	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
	"postCreateCommand": {
		"community modules": "ansible-galaxy collection install community.general community.docker",
		"molecule": "pip install \"molecule\" \"molecule-plugins[docker]\""
	}
}
